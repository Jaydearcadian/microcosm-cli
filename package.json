{
  "name": "microcosm-cli",
  "version": "0.1.0",
  "description": "Installable Microcosm programmable payments CLI for Arc.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "mcosm": "./bin/mcosm.mjs"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "arc-policy-envelope": "https://codeload.github.com/Jaydearcadian/arc-policy-envelope/tar.gz/865fbdb205af702b310cb2ec8e40c504aae6b007",
    "arc-proof-of-payable": "https://codeload.github.com/Jaydearcadian/arc-proof-of-payable/tar.gz/68a46cb92d398dc8a7be14568906ae881b924196"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
