{
  "name": "mcosm",
  "version": "0.1.0",
  "description": "Installable Microcosm programmable payments CLI for Arc.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "mcosm": "./bin/mcosm.mjs"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
