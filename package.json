{
  "name": "microcosm-cli",
  "version": "0.1.0",
  "description": "Installable Microcosm programmable payments CLI for Arc.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "mcosm": "./bin/mcosm.mjs"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test --import tsx test/*.test.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "arc-policy-envelope": "https://codeload.github.com/Jaydearcadian/arc-policy-envelope/tar.gz/b694f829f8066e415b94381aadc2398b5e6b20b7",
    "arc-proof-of-payable": "https://codeload.github.com/Jaydearcadian/arc-proof-of-payable/tar.gz/7790524606c3e4b6550a513e199442434c10e730"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
