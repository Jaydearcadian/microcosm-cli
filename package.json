    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "arc-policy-envelope": "https://codeload.github.com/Jaydearcadian/arc-policy-envelope/tar.gz/d1eeac6c9a0a0677f0064dfa897aa1d655a0691c",
    "arc-proof-of-payable": "https://codeload.github.com/Jaydearcadian/arc-proof-of-payable/tar.gz/40045515617bc921921fbaa7af24698a0f3818fe"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
